# Application
APP_NAME=AI Document Search
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=500
MAX_PDF_TEXT_CHARS=5000000
UPLOAD_DIR=uploads
RATE_LIMIT_PER_MINUTE=30

# PostgreSQL in Docker; SQLite works for zero-config local development.
DATABASE_URL=postgresql+psycopg://verity:verity@postgres:5432/verity
# DATABASE_URL=sqlite:///./ai_document_search.db

# Retrieval. Leave QDRANT_URL blank for the deterministic local vector fallback.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=verity_chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
PRELOAD_MODELS=true
RETRIEVAL_TOP_K=8
MINIMUM_RELEVANCE_SCORE=0.12
CHUNK_SIZE=900
CHUNK_OVERLAP=140

# This release implements extractive generation only. The remaining fields are reserved.
LLM_PROVIDER=extractive
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

